---
layout: layouts/base.njk
---
{#
  Άρθρο / ανακοίνωση (src/nea/*.md).
  Front matter: title, date, image, excerpt
#}
<article>
  <header class="page-head">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">
        <time datetime="{{ date | isoDate }}">{{ date | dateGR }}</time>
      </p>
      <h1 class="page-head__title">{{ title }}</h1>
      <p class="page-head__lead">{{ excerpt }}</p>
    </div>
  </header>

  <div class="section wrap wrap--narrow">
    <img
      class="post__image"
      src="{{ image }}"
      alt=""
      width="1200"
      height="675"
    />

    <div class="prose">{{ content | safe }}</div>

    <p class="post__back">
      <a class="arrow-link" href="/nea/">Όλα τα νέα</a>
    </p>
  </div>
</article>
